// 家庭食谱口述整理器 · 数据模型
//
// 说明：
// 1. SQLite 不支持数据库级 enum，所有状态字段以 String 存储，
//    取值集合由 packages/shared/src/enums.ts + Zod schema 在应用层约束。
// 2. SQLite 的 Json 支持在各版本间不一致，因此所有 JSON 字段统一以 String(TEXT)
//    存储，读写经 apps/server/src/lib/json.ts 序列化，避免跨版本行为差异。
// 3. 数据隔离边界是 Workspace：所有业务表都能沿着 recipeId / workspaceId 回溯到空间。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// 用户与空间
// ------------------------------------------------------------------

model User {
  id           String   @id
  email        String   @unique
  passwordHash String
  displayName  String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships        WorkspaceMember[]
  ownedWorkspaces    Workspace[]        @relation("WorkspaceOwner")
  recipesCreated     Recipe[]           @relation("RecipeCreatedBy")
  versionsCreated    RecipeVersion[]    @relation("VersionCreatedBy")
  audioOwned         AudioAttachment[]  @relation("AudioOwner")
  clipsCreated       AudioClip[]        @relation("ClipCreatedBy")
  vagueItemsCreated  VagueItem[]        @relation("VagueCreatedBy")
  vagueItemsAssigned VagueItem[]        @relation("VagueAssignee")
  vagueItemsResolved VagueItem[]        @relation("VagueResolvedBy")
  comments           Comment[]
  verifications      VerificationRun[]
  notifications      Notification[]
  activities         ActivityLog[]
  referencesCreated  KitchenReference[]
  timelinesCreated   AudioTimeline[]   @relation("TimelineCreatedBy")
  timelinesMerged    AudioTimeline[]   @relation("TimelineMergedBy")
}

model Workspace {
  id         String   @id
  name       String
  ownerId    String
  inviteCode String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner      User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members    WorkspaceMember[]
  recipes    Recipe[]
  audio      AudioAttachment[]
  activities ActivityLog[]
  references KitchenReference[]
}

model WorkspaceMember {
  id          String   @id
  workspaceId String
  userId      String
  role        String
  joinedAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

/// 参照物登记：先把"家里那只勺、那只碗"量化一次，之后"一勺""一碗"才能换算成克。
/// 这是把模糊用量变成数值最有效的手段（项目文档 12.2）。
model KitchenReference {
  id          String   @id
  workspaceId String
  label       String
  amountValue Float
  amountUnit  String
  note        String?
  createdBy   String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator   User      @relation(fields: [createdBy], references: [id])

  @@unique([workspaceId, label])
}

// ------------------------------------------------------------------
// 食谱与版本
// ------------------------------------------------------------------

model Recipe {
  id           String   @id
  workspaceId  String
  title        String
  dishCategory String?
  coverUrl     String?
  status       String   @default("active")
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator       User              @relation("RecipeCreatedBy", fields: [createdBy], references: [id])
  versions      RecipeVersion[]
  audio         AudioAttachment[]
  vagueItems    VagueItem[]
  verifications VerificationRun[]
  timelines     AudioTimeline[]

  @@index([workspaceId, status])
}

/// 版本一旦 published 即内容不可变，只能 fork 出新草稿（项目文档 13.1）。
model RecipeVersion {
  id              String    @id
  recipeId        String
  versionNo       Int
  parentVersionId String?
  status          String    @default("draft")
  title           String
  summary         String?
  changeNote      String?
  createdBy       String
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  recipe        Recipe          @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  creator       User            @relation("VersionCreatedBy", fields: [createdBy], references: [id])
  parent        RecipeVersion?  @relation("VersionFork", fields: [parentVersionId], references: [id])
  children      RecipeVersion[] @relation("VersionFork")
  steps         Step[]
  ingredients   Ingredient[]
  vagueItems    VagueItem[]
  verifications VerificationRun[]

  @@unique([recipeId, versionNo])
  @@index([recipeId, status])
}

model Step {
  id               String   @id
  versionId        String
  orderIndex       Int
  title            String
  instruction      String
  heatLevel        String?
  heatText         String?
  temperatureCMin  Float?
  temperatureCMax  Float?
  durationSecondsMin Int?
  durationSecondsMax Int?
  /// JSON 字符串数组：颜色/声音/气味/气泡等观察指标
  sensoryCues      String?
  tool             String?
  sourceClipId     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  version    RecipeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  sourceClip AudioClip?    @relation("StepSourceClip", fields: [sourceClipId], references: [id])
  vagueItems VagueItem[]

  @@index([versionId, orderIndex])
}

model Ingredient {
  id          String   @id
  versionId   String
  orderIndex  Int
  name        String
  /// 原话，例如"一点"
  amountText  String?
  amountValue Float?
  amountUnit  String?
  amountMin   Float?
  amountMax   Float?
  isVague     Boolean  @default(false)
  vagueItemId String?
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  version   RecipeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  vagueItem VagueItem?    @relation("IngredientVagueItem", fields: [vagueItemId], references: [id])

  @@index([versionId, orderIndex])
}

// ------------------------------------------------------------------
// 音频
// ------------------------------------------------------------------

/// 音频只增不改不删（软删除），是全部结论的最终证据。
model AudioAttachment {
  id               String    @id
  workspaceId      String
  recipeId         String
  ownerId          String
  kind             String
  storagePath      String
  mimeType         String
  sizeBytes        Int
  durationMs       Int
  /// JSON 数字数组：客户端预计算的归一化波形峰值
  peaks            String?
  sha256           String
  transcript       String?
  transcriptStatus String    @default("none")
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipe    Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  owner     User      @relation("AudioOwner", fields: [ownerId], references: [id])
  clips     AudioClip[]
  timelineTracks TimelineTrack[]

  @@index([recipeId, kind])
  @@index([recipeId, transcriptStatus])
}

model AudioClip {
  id                String   @id
  audioAttachmentId String
  startMs           Int
  endMs             Int
  label             String?
  createdBy         String
  createdAt         DateTime @default(now())

  audio            AudioAttachment @relation(fields: [audioAttachmentId], references: [id], onDelete: Cascade)
  creator          User            @relation("ClipCreatedBy", fields: [createdBy], references: [id])
  stepSources      Step[]          @relation("StepSourceClip")
  vagueItemClips   VagueItem[]     @relation("VagueItemClip")
  vagueItemAnswers VagueItem[]     @relation("VagueItemAnswerClip")

  @@index([audioAttachmentId])
}

// ------------------------------------------------------------------
// 口述时间轴：同一道菜的多段口述排到同一条虚拟时间轴
// ------------------------------------------------------------------
//
// 关键约束：音频永远是只增不改的证据。时间轴**不拼接、不复制、不删除**
// 任何音频文件，它只是一个"顺序 + 偏移 + 重复表述人工裁定"的整理层。
// 多段录音仍各自可独立回放，时间轴上每个结论都能顺着 track → audio 回到原声。

/// 每张食谱至多一条进行中的时间轴；合并定稿后可重开继续整理。
model AudioTimeline {
  id               String    @id
  recipeId         String
  status           String    @default("building")
  title            String?
  /// 合并定稿后的转写全文（重复句按人工裁定只保留首选句）
  mergedTranscript String?
  totalDurationMs  Int?
  createdBy        String
  mergedBy         String?
  mergedAt         DateTime?
  /// 合并时填写的取舍说明
  changeNote       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  recipe          Recipe                    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  creator         User                      @relation("TimelineCreatedBy", fields: [createdBy], references: [id])
  merger          User?                     @relation("TimelineMergedBy", fields: [mergedBy], references: [id])
  tracks          TimelineTrack[]
  duplicateGroups TimelineDuplicateGroup[]

  @@index([recipeId, status])
}

model TimelineTrack {
  id         String   @id
  timelineId String
  audioId    String
  /// 在合并时间轴上的起点毫秒，由前面各段时长累加；重排后全量重算
  offsetMs   Int      @default(0)
  orderIndex Int
  durationMs Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  timeline AudioTimeline    @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  audio    AudioAttachment  @relation(fields: [audioId], references: [id], onDelete: Cascade)

  @@unique([timelineId, audioId])
  @@index([timelineId, orderIndex])
}

/// 自动标出的"疑似重复表述"组；必须逐组经人工确认后，时间轴才允许合并。
model TimelineDuplicateGroup {
  id          String   @id
  timelineId  String
  /// JSON：{ audioId, sentence }[]，检测时刻的快照
  members     String
  /// 组内最低相似度 0..1
  score       Float
  status      String   @default("pending")
  /// 确认重复时，保留哪一句所在的音频
  keepAudioId String?
  reviewNote  String?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  timeline AudioTimeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)

  @@index([timelineId, status])
}

// ------------------------------------------------------------------
// 待澄清条目（本项目核心工作对象）
// ------------------------------------------------------------------

model VagueItem {
  id               String    @id
  recipeId         String
  versionId        String?
  stepId           String?
  clipId           String?
  category         String
  rawPhrase        String
  transcript       String?
  status           String    @default("open")
  assigneeId       String?
  question         String?
  questionAskedAt  DateTime?
  answerText       String?
  answerClipId     String?
  answerAt         DateTime?
  /// JSON：ResolvedSpec
  resolvedSpec     String?
  confidence       String?
  unresolvableNote String?
  resolvedBy       String?
  resolvedAt       DateTime?
  /// 若由复做失败打回，指向那条验证记录
  reopenedFromVerificationId String?
  createdBy        String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  recipe     Recipe          @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  version    RecipeVersion?  @relation(fields: [versionId], references: [id])
  step       Step?           @relation(fields: [stepId], references: [id])
  clip       AudioClip?      @relation("VagueItemClip", fields: [clipId], references: [id])
  answerClip AudioClip?      @relation("VagueItemAnswerClip", fields: [answerClipId], references: [id])
  assignee   User?           @relation("VagueAssignee", fields: [assigneeId], references: [id])
  resolver   User?           @relation("VagueResolvedBy", fields: [resolvedBy], references: [id])
  creator    User            @relation("VagueCreatedBy", fields: [createdBy], references: [id])
  reopenedFrom VerificationRun? @relation("VerificationReopen", fields: [reopenedFromVerificationId], references: [id])
  ingredients Ingredient[]   @relation("IngredientVagueItem")

  @@index([recipeId, status])
  @@index([recipeId, category])
  @@index([assigneeId, status])
}

// ------------------------------------------------------------------
// 协作
// ------------------------------------------------------------------

/// 多态评论：targetType + targetId 指向任意实体（项目文档 8.2）。
model Comment {
  id         String    @id
  targetType String
  targetId   String
  authorId   String
  parentId   String?
  body       String
  /// JSON 字符串数组：被 @ 的用户 id
  mentions   String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  author  User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")

  @@index([targetType, targetId])
}

model VerificationRun {
  id          String   @id
  recipeId    String
  versionId   String
  performedBy String
  performedAt DateTime @default(now())
  result      String
  deviations  String?
  /// JSON 字符串数组
  photoUrls   String?
  voiceClipId String?
  createdAt   DateTime @default(now())

  recipe    Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  version   RecipeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  performer User          @relation(fields: [performedBy], references: [id])
  reopenedItems VagueItem[] @relation("VerificationReopen")

  @@index([recipeId, createdAt])
}

model Notification {
  id        String    @id
  userId    String
  type      String
  payload   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model ActivityLog {
  id          String   @id
  workspaceId String
  actorId     String
  action      String
  entityType  String
  entityId    String
  /// JSON：{ before, after }
  diff        String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User      @relation(fields: [actorId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
}
